# Copy to .env and set a strong unique database password. Never commit .env.
POSTGRES_USER=omnichat
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=omnichat
POSTGRES_PORT=55432
DATABASE_URL=postgresql://omnichat:replace-with-a-long-random-password@127.0.0.1:55432/omnichat?schema=public
TEST_DATABASE_URL=postgresql://omnichat:replace-with-a-long-random-password@127.0.0.1:55432/omnichat_test?schema=public
API_PORT=4010
API_HOST=127.0.0.1
WEB_PORT=3210
API_INTERNAL_URL=http://127.0.0.1:4010
WEB_ORIGINS=http://localhost:3210,http://127.0.0.1:3210
COOKIE_SECURE=false
SESSION_DAYS=30
UPLOAD_DIR=./data/uploads
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
# Only enable if your local OmniRoute intentionally permits unauthenticated API access.
OMNIROUTE_ALLOW_NO_AUTH=false
# Set this separately for Docker; host.docker.internal must be reachable from a container.
DOCKER_OMNIROUTE_BASE_URL=http://host.docker.internal:20128/v1
# Mobile API origin only (no /api suffix). Set your reachable LAN or HTTPS address.
EXPO_PUBLIC_API_URL=
OMNICHAT_DESKTOP_URL=http://localhost:3210
LIVE_OMNIROUTE_TESTS=false

# Optional coding command sandbox; requires Docker CLI access and an already-pulled image.
CODING_EXECUTOR=disabled
CODING_EXECUTOR_IMAGE=node:22-bookworm-slim
# Explicit per-account access to local source folders on the API computer. JSON, no trailing comma.
# Example: [{"email":"you@example.com","path":"C:/Projects"}]
CODING_LOCAL_PROJECTS=[]
